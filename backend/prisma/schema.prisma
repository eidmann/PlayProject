generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection for the app; direct connection for migrations
  // (Neon's pooler doesn't support the session features migrations need).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Mood {
  GREAT
  GOOD
  OKAY
  LOW
  BAD
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  createdAt DateTime       @default(now())
  entries   JournalEntry[]
}

model JournalEntry {
  id        String   @id @default(cuid())
  title     String
  content   String
  mood      Mood?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional until milestone 6 (auth); entries then become user-scoped.
  user   User?   @relation(fields: [userId], references: [id])
  userId String?
}
